{
  "_comment": "NexusFlow — Kafka Connect S3 Sink Configuration",
  "_note": "This config is for reference — actual S3 landing handled by kafka_consumer.py",
  "_region": "ca-central-1",

  "orders_sink": {
    "name": "nexusflow-s3-sink-orders",
    "config": {
      "connector.class":              "io.confluent.connect.s3.S3SinkConnector",
      "tasks.max":                    "3",
      "topics":                       "orders",
      "s3.region":                    "ca-central-1",
      "s3.bucket.name":               "nexusflow-dev-lakehouse",
      "s3.part.size":                 "67108864",
      "flush.size":                   "1000",
      "rotate.interval.ms":           "30000",
      "rotate.schedule.interval.ms":  "3600000",
      "storage.class":                "io.confluent.connect.s3.storage.S3Storage",
      "format.class":                 "io.confluent.connect.s3.format.json.JsonFormat",
      "locale":                       "en_CA",
      "timezone":                     "UTC",
      "timestamp.extractor":          "RecordField",
      "timestamp.field":              "order_date",
      "partitioner.class":            "io.confluent.connect.storage.partitioner.TimeBasedPartitioner",
      "path.format":                  "'date'=YYYY-MM-dd",
      "partition.duration.ms":        "86400000",
      "topics.dir":                   "bronze",
      "s3.ssea.name":                 "AES256",
      "errors.tolerance":             "all",
      "errors.deadletterqueue.topic.name": "dlq-orders",
      "errors.deadletterqueue.context.headers.enable": "true"
    }
  },

  "clickstream_sink": {
    "name": "nexusflow-s3-sink-clickstream",
    "config": {
      "connector.class":              "io.confluent.connect.s3.S3SinkConnector",
      "tasks.max":                    "6",
      "topics":                       "clickstream",
      "s3.region":                    "ca-central-1",
      "s3.bucket.name":               "nexusflow-dev-lakehouse",
      "s3.part.size":                 "67108864",
      "flush.size":                   "5000",
      "rotate.interval.ms":           "30000",
      "storage.class":                "io.confluent.connect.s3.storage.S3Storage",
      "format.class":                 "io.confluent.connect.s3.format.avro.AvroFormat",
      "locale":                       "en_CA",
      "timezone":                     "UTC",
      "timestamp.extractor":          "RecordField",
      "timestamp.field":              "event_ts",
      "partitioner.class":            "io.confluent.connect.storage.partitioner.TimeBasedPartitioner",
      "path.format":                  "'date'=YYYY-MM-dd",
      "partition.duration.ms":        "86400000",
      "topics.dir":                   "bronze",
      "s3.ssea.name":                 "AES256"
    }
  },

  "inventory_sink": {
    "name": "nexusflow-s3-sink-inventory",
    "config": {
      "connector.class":              "io.confluent.connect.s3.S3SinkConnector",
      "tasks.max":                    "2",
      "topics":                       "inventory-events",
      "s3.region":                    "ca-central-1",
      "s3.bucket.name":               "nexusflow-dev-lakehouse",
      "flush.size":                   "500",
      "rotate.interval.ms":           "60000",
      "storage.class":                "io.confluent.connect.s3.storage.S3Storage",
      "format.class":                 "io.confluent.connect.s3.format.json.JsonFormat",
      "locale":                       "en_CA",
      "timezone":                     "UTC",
      "partitioner.class":            "io.confluent.connect.storage.partitioner.TimeBasedPartitioner",
      "path.format":                  "'date'=YYYY-MM-dd",
      "partition.duration.ms":        "86400000",
      "topics.dir":                   "bronze",
      "s3.ssea.name":                 "AES256"
    }
  }
}
